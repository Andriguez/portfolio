(security_headers) {
    header {
        defer
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Opener-Policy same-origin
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self';"
    }
}

andriguez.dev {
    encode zstd gzip
    request_body {
        max_size 12MB
    }

    import security_headers

    handle /api/* {
        reverse_proxy backend:8000 {
            header_down -Server
        }
    }
    handle /uploads/* {
        reverse_proxy backend:8000 {
            header_down -Server
        }
    }
    handle {
        root * /srv/frontend

        # only cache public assets for a year
        header /assets/* Cache-Control "public, max-age=31536000, immutable"

        @notAssets not path /assets/*
        header @notAssets ?Cache-Control "no-cache"

        # SPA fallback for app routes only
        @spaRoute {
            not file
            not path_regexp (^|/)\.|\.[A-Za-z0-9]+$
        }
        rewrite @spaRoute /index.html
        file_server
    }

    handle_errors {
        import security_headers
        respond "{err.status_code}: {err.status_text}" {err.status_code}
    }
}

www.andriguez.dev {
    import security_headers
    redir https://andriguez.dev{uri} permanent
}